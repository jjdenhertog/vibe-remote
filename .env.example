# GitHub Authentication Token
# Create at: https://github.com/settings/tokens?type=beta
# Required permissions:
#   - Repository: Contents (Read/Write), Metadata (Read)
#   - Optional: Pull requests (Read/Write), Issues (Read/Write)
#   - Account: Organizations (Read) - if working with org repos
GITHUB_TOKEN=ghp_your_token_here

# Developer password for SSH access
DEVELOPER_PASSWORD=changeme

# Git Configuration
GIT_USERNAME=Your Name
GIT_USEREMAIL=your@email.com

# Project name (used for display)
PROJECT_NAME=vibe-remote-workstation

# Optional: SSH public key for key-based auth
# PUBLIC_KEY=ssh-rsa AAAAB3...

# Optional: User/Group ID matching (for file permissions)
# USER_ID=1000
# GROUP_ID=1000

# Timezone
TZ=UTC

# Vibe Kanban URL
NEXT_PUBLIC_VIBE_KANBAN_URL=http://localhost:9091